<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 600" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0b0f19" />
      <stop offset="50%" stop-color="#07090e" />
      <stop offset="100%" stop-color="#0f172a" />
    </linearGradient>
    
    <linearGradient id="suitGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#1e293b" />
      <stop offset="100%" stop-color="#0f172a" />
    </linearGradient>

    <linearGradient id="shirtGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#f8fafc" />
      <stop offset="100%" stop-color="#cbd5e1" />
    </linearGradient>

    <linearGradient id="tieGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00f2fe" />
      <stop offset="100%" stop-color="#8b5cf6" />
    </linearGradient>

    <filter id="cyanGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="12" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Dark Premium Backdrop -->
  <rect width="500" height="600" fill="url(#bgGrad)" />

  <!-- Ambient Rim Light Glows -->
  <circle cx="120" cy="150" r="180" fill="#00f2fe" opacity="0.12" filter="url(#cyanGlow)" />
  <circle cx="380" cy="400" r="180" fill="#8b5cf6" opacity="0.12" filter="url(#cyanGlow)" />

  <!-- Futuristic Background Grid Lines -->
  <path d="M0 100 H500 M0 200 H500 M0 300 H500 M0 400 H500 M0 500 H500" stroke="rgba(255,255,255,0.03)" stroke-width="1" />
  <path d="M100 0 V600 M200 0 V600 M300 0 V600 M400 0 V600" stroke="rgba(255,255,255,0.03)" stroke-width="1" />

  <!-- Suit & Body -->
  <!-- Shoulders / Black Formal Suit -->
  <path d="M100 580 C 100 440, 160 410, 250 410 C 340 410, 400 440, 400 580 Z" fill="url(#suitGrad)" stroke="#334155" stroke-width="2" />
  
  <!-- Suit Lapels -->
  <path d="M170 420 L220 540 L250 580 L280 540 L330 420" fill="none" stroke="#475569" stroke-width="3" />
  <path d="M190 410 L250 520 L310 410" fill="url(#shirtGrad)" />
  
  <!-- Slim Tie with Cyan/Violet Gradient -->
  <polygon points="243,440 257,440 262,560 250,580 238,560" fill="url(#tieGrad)" />

  <!-- Neck -->
  <rect x="225" y="330" width="50" height="90" rx="10" fill="#e2e8f0" opacity="0.9" />

  <!-- Head & Face Structure -->
  <ellipse cx="250" cy="250" rx="75" ry="95" fill="#f1f5f9" stroke="#00f2fe" stroke-width="1.5" />

  <!-- Hair / Styled Haircut -->
  <path d="M170 240 C 165 170, 210 140, 250 140 C 290 140, 335 170, 330 240 C 320 180, 280 155, 250 155 C 220 155, 180 180, 170 240 Z" fill="#0f172a" />
  <path d="M175 220 Q 250 130 325 220 Q 250 145 175 220 Z" fill="#1e293b" />

  <!-- Eyes / Eyeglasses (Tech Developer Look) -->
  <rect x="195" y="225" width="42" height="28" rx="6" fill="none" stroke="#00f2fe" stroke-width="3" />
  <rect x="263" y="225" width="42" height="28" rx="6" fill="none" stroke="#00f2fe" stroke-width="3" />
  <line x1="237" y1="239" x2="263" y2="239" stroke="#00f2fe" stroke-width="3" />

  <!-- Subtle Smile -->
  <path d="M230 295 Q 250 310 270 295" fill="none" stroke="#334155" stroke-width="3" stroke-linecap="round" />

  <!-- Rim Lighting Glow Effect -->
  <path d="M173 250 A77 97 0 0 1 327 250" fill="none" stroke="#00f2fe" stroke-width="3" opacity="0.6" filter="url(#cyanGlow)" />

  <!-- Overlay Name Badge Banner -->
  <rect x="100" y="20" width="300" height="42" rx="21" fill="rgba(15, 23, 42, 0.85)" stroke="#00f2fe" stroke-width="1.5" />
  <text x="250" y="47" text-anchor="middle" fill="#00f2fe" font-family="'Outfit', sans-serif" font-size="16" font-weight="bold" letter-spacing="2">HIREN PRAJAPATI</text>
</svg>
